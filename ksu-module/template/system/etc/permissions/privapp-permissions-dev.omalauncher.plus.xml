<?xml version="1.0" encoding="utf-8"?>
<!-- Every privileged permission Omalauncher+ asks for must be here, or Android won't start with it as a system app. -->
<permissions>
    <privapp-permissions package="dev.omalauncher.plus">
        <permission name="android.permission.CONTROL_REMOTE_APP_TRANSITION_ANIMATIONS" />
    </privapp-permissions>
</permissions>
